{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/{index,parse,parse-module,parse-imports-exports,parse-sections,is-valid-type,runes,core,typescript,entities,walk,lexer}.ts",
    "scripts/*.ts",
    "bench/*.ts",
    "examples/*.ts",
    "tests/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "bench/**/*.ts",
    "examples/**/*.ts"
  ],
  "ignoreDependencies": ["@types/estree"]
}
