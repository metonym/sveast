{
  "name": "svelte-ast",
  "version": "0.11.1",
  "license": "MIT",
  "description": "Fast, zero-dependency Svelte 5 parser with svelte/compiler's AST.",
  "author": "Eric Liu (https://github.com/metonym)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test --parallel ./tests",
    "test:changed": "bivium run --suite unit",
    "test:package": "bun scripts/test-package.ts",
    "bench": "ostia bench bench/parse.bench.ts",
    "bench:ab": "ostia ab bench/svelte-ast.bench.ts",
    "bench:svelte-ast": "ostia bench bench/svelte-ast.bench.ts",
    "bench:mem": "bun bench/mem.ts",
    "bench:cold": "bun bench/cold.ts",
    "bench:size": "bun bench/size.ts",
    "fuzz": "bun scripts/fuzz-parser.ts",
    "typecheck": "bun check",
    "knip": "knip-bun",
    "lint:all": "bun fmt && bun lint --fix",
    "lint:changed": "bun fmt --staged && bun lint --staged --fix"
  },
  "devDependencies": {
    "@sveltejs/acorn-typescript": "1.0.13",
    "@types/bun": "^1.4.4",
    "@types/estree": "^1.0.9",
    "@types/jest": "^30.0.0",
    "@typescript/typescript6": "^6.0.2",
    "acorn": "^8.19.0",
    "bivium": "^0.4.0",
    "knip": "^6.43.0",
    "ostia": "^0.2.12",
    "svelte": "5.58.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/svelte-ast.git"
  },
  "homepage": "https://github.com/metonym/svelte-ast",
  "bugs": "https://github.com/metonym/svelte-ast/issues",
  "keywords": [
    "svelte",
    "parser",
    "ast",
    "typescript",
    "acorn",
    "zero-dependency"
  ]
}
