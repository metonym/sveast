{
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "target": "ESNext",
    "module": "preserve",
    "strict": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "sveast": ["./src/index.ts"],
      "sveast/*": ["./src/*.ts"]
    },
    "types": ["bun", "jest"]
  },
  "include": ["bench", "scripts", "src", "tests"]
}
